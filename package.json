{
  "name": "xp-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "build": "vue-tsc --noEmit && vite build",
    "validate:runtime-manifest": "bun tools/validate-runtime-manifest.mjs",
    "validate:environment-evidence": "bun tools/validate-environment-evidence.mjs",
    "collect:evidence": "pwsh -NoProfile -File ./tools/collect-environment-evidence.ps1",
    "validate:before-bundle": "pwsh -NoProfile -File ./tools/validate-before-bundle.ps1",
    "test:runtime-supply": "pwsh -NoProfile -File ./tools/tests/test-runtime-supply.ps1",
    "test:rust": "pwsh -NoProfile -File ./tools/test-rust.ps1",
    "test": "bun run typecheck && bun run lint && bun run test:unit && bun run build && bun run test:rust && bun run test:runtime-supply",
    "tauri": "tauri",
    "app:dev": "pwsh -NoProfile -File ./tools/run-tauri.ps1 -Mode Dev",
    "app:build": "pwsh -NoProfile -File ./tools/run-tauri.ps1 -Mode Build",
    "verify:bundle": "pwsh -NoProfile -File ./tools/verify-bundle.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.1",
    "ajv": "8.17.1",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
