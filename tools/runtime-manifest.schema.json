{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xp-capture.local/schemas/runtime-manifest.schema.json",
  "title": "XP Capture native runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAtUtc", "vcpkgRevision", "triplet", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "vcpkgRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "triplet": { "const": "x64-windows" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtimeFile" }
    }
  },
  "$defs": {
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "architecture", "source", "bundleDestination", "purpose", "licenseNoticePath"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.dll$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "architecture": { "const": "x64" },
        "source": {
          "type": "string",
          "pattern": "^(?:\\.vcpkg_installed/x64-windows/(?:bin|tools/[A-Za-z0-9._-]+)|\\.tools/msvc-redist/[0-9]+\\.[0-9]+\\.[0-9]+/x64/Microsoft\\.VC143\\.CRT)/[A-Za-z0-9][A-Za-z0-9._-]*\\.dll$"
        },
        "bundleDestination": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.dll$"
        },
        "purpose": { "enum": ["opencv", "codec", "transitive"] },
        "licenseNoticePath": {
          "type": "string",
          "pattern": "^(?:\\.vcpkg_installed/x64-windows/share/[A-Za-z0-9._-]+/[A-Za-z0-9][A-Za-z0-9._-]*|\\.tools/msvc-redist/[0-9]+\\.[0-9]+\\.[0-9]+/Redist\\.txt)$"
        }
      }
    }
  }
}
